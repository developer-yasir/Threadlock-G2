# ThreadLock G2 Environment Configuration Template
# Copy to .env and adjust as needed. Zero committed secrets.

# Backend Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Real-Time SSE Stream Configuration
STREAM_HEARTBEAT_MS=15000

# Telegram Bridge Configuration (Optional)
# If provided, the Telegram long-polling / webhook bridge will connect to your bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=@your_bot_username
TELEGRAM_POLLING=true
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Semantic Drift Engine / LLM Configuration (Optional)
# Deterministic rule-based engine is active by default.
# Supply one of the following to activate optional deep semantic analysis:
LLM_PROVIDER=none # 'none' | 'openai' | 'gemini'
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Even Hub & Pairing Security
DEFAULT_UNDO_WINDOW_SECONDS=30
AUDIT_LOG_SALT=threadlock-g2-salt-change-in-prod
PAIRING_CODE_EXPIRY_MINUTES=60
